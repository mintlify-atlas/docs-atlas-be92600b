  "keyFeatures": [
    "Kanban lead pipeline with 7 stages and one-click lead-to-wedding conversion",
    "Wedding project dashboard with 6 tabbed modules per wedding",
    "SOP-driven checklist engine with pre-built templates and auto-calculated due dates",
    "Vendor database with 16 categories and follow-up tracking",
    "Token-based client portal with configurable permissions",
    "Token-based guest RSVP portal with per-event attendance and dietary preferences",
    "QR code check-in with HMAC-SHA256 signature verification",
    "Digital invitation builder with 5 themes and 9 languages",
    "Visual seating chart with drag-and-drop guest assignment",
    "Multi-channel reminder engine (WhatsApp, SMS, Email) powered by BullMQ + Redis",
    "Bidirectional CRM ↔ RSVP integration via REST API and real-time webhooks",
    "Photo wall with guest uploads, moderation, and Cloudinary CDN",
    "Analytics dashboard with per-event RSVP breakdown and dietary distribution",
    "Accommodation management with hotel rooms and guest-to-room assignment"
  ],
